+def cuadrilatero_sile():
+    """La geometria de la v3 (escala por las lineas de agua) como cuadrilatero."""
+    e = 1.8288 / (1463 - 438)                    # m/px, las filas de la v3
+    a = np.radians(-1.0)                         # ANGULO_FLUJO de la v3
